{
  "name": "code-foundry-gui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --mode production",
    "build:dev": "tsc -b && vite build --minify false --mode development",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "mock": "tsx mock/server.ts",
    "mock:emit": "tsx mock/emit.ts",
    "dev:mock": "vite --mode mock",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts"
  },
