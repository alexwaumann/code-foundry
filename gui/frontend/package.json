    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@wailsio/runtime": "3.0.0-beta.28",
    "@xterm/addon-fit": "0.11.0",
