{
  "name": "code-foundry-gui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun check -b && vite build --mode production",
    "build:dev": "bun check -b && vite build --minify false --mode development",
    "preview": "vite preview",
    "typecheck": "bun check -b",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "vitest run",
    "mock": "tsx mock/server.ts",
    "mock:emit": "tsx mock/emit.ts",
    "themes": "tsx themes/convert.ts",
    "themes:check": "tsx themes/check.ts",
    "pagelib": "vite build -c vite.pagelib.config.ts --mode modules && vite build -c vite.pagelib.config.ts --mode scripts",
    "dev:mock": "vite --mode mock",
    "e2e": "playwright test",
    "e2e:live": "playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@pierre/diffs": "1.5.2",
    "@tanstack/react-virtual": "3.14.13",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-document": "3.31.4",
    "@tiptap/extension-paragraph": "3.31.4",
    "@tiptap/extension-text": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@wailsio/runtime": "3.0.0-beta.34",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "lowlight": "3.3.0",
    "lucide-react": "1.49.0",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "sonner": "2.0.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@connectrpc/connect-node": "2.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/browser": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "shadcn": "4.21.0",
    "sucrase": "3.35.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "patchedDependencies": {
    "@wailsio/runtime@3.0.0-beta.34": "patches/@wailsio__runtime@3.0.0-beta.34.patch"
